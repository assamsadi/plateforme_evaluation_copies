"use client";

import { useState } from "react";

import { IconChartRadar, IconSparkles } from "@tabler/icons-react";
import { useTranslations } from "next-intl";

import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@/components/ui/select";
import type { RecommendedExerciseRead, StudentCompetencyReport, VideoOverviewStatus } from "@/lib/student-api";

import { CompetencyDetailCard } from "./competency-detail-card";
import { CompetencyRadarChart } from "./competency-radar-chart";
import { NotebookSheet } from "./notebook-sheet";
import { RecommendationCard } from "./recommendation-card";

export interface ModuleOption {
  id: string;
  name: string;
}

export function MyProgress({
  modules,
  selectedModuleId,
  onModuleChange,
  report,
  recommendations,
  onRecommendationVideoStateChange,
  isLoading,
}: {
  modules: ModuleOption[];
  selectedModuleId: string | null;
  onModuleChange: (moduleId: string) => void;
  report: StudentCompetencyReport | null;
  recommendations: RecommendedExerciseRead[];
  onRecommendationVideoStateChange: (
    recommendationId: string,
    status: VideoOverviewStatus,
    url: string | null,
  ) => void;
  isLoading: boolean;
}) {
  const t = useTranslations("MyProgress");
  const [notebookTarget, setNotebookTarget] = useState<RecommendedExerciseRead | null>(null);

  const activeNotebookRecommendation =
    recommendations.find((recommendation) => recommendation.id === notebookTarget?.id) ?? notebookTarget;

  return (
    <div className="flex flex-col gap-6">
      <div className="flex flex-col gap-1.5 sm:max-w-xs">
        <span className="text-sm font-medium text-muted-foreground">{t("moduleSelectorLabel")}</span>
        <Select value={selectedModuleId ?? undefined} onValueChange={onModuleChange}>
          <SelectTrigger>
            <SelectValue placeholder={t("moduleSelectorPlaceholder")} />
          </SelectTrigger>
          <SelectContent>
            {modules.map((module) => (
              <SelectItem key={module.id} value={module.id}>
                {module.name}
              </SelectItem>
            ))}
          </SelectContent>
        </Select>
      </div>

      {isLoading ? (
        <div className="flex items-center justify-center gap-2 py-16">
          <div className="size-4 animate-spin rounded-full border-2 border-primary border-t-transparent" />
          <p className="text-sm text-muted-foreground">{t("loading")}</p>
        </div>
      ) : !report || report.lines.length === 0 ? (
        <div className="rounded-xl border border-dashed py-16 text-center">
          <p className="text-sm text-muted-foreground">{t("noCompetencyData")}</p>
        </div>
      ) : (
        <>
          <section className="flex flex-col gap-4">
            <h2 className="flex items-center gap-2 text-base font-medium text-foreground">
              <IconChartRadar className="size-4.5 text-primary" stroke={1.75} />
              {t("radarTitle")}
            </h2>
            <div className="rounded-2xl border-[0.5px] border-primary/15 bg-primary/5 p-6">
              <CompetencyRadarChart lines={report.lines} />
            </div>
          </section>

          <section className="flex flex-col gap-4">
            <h2 className="text-base font-medium text-foreground">{t("detailTitle")}</h2>
            <div className="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
              {report.lines.map((line) => (
                <CompetencyDetailCard key={line.competency} line={line} />
              ))}
            </div>
          </section>

          <section className="flex flex-col gap-4">
            <h2 className="flex items-center gap-2 text-base font-medium text-foreground">
              <IconSparkles className="size-4.5 text-primary" stroke={1.75} />
              {t("recommendationsTitle")}
            </h2>
            {recommendations.length === 0 ? (
              <div className="rounded-xl border border-dashed py-10 text-center">
                <p className="text-sm text-muted-foreground">{t("noRecommendations")}</p>
              </div>
            ) : (
              <div className="grid gap-4 sm:grid-cols-2">
                {recommendations.map((recommendation) => (
                  <RecommendationCard
                    key={recommendation.id}
                    recommendation={recommendation}
                    onOpenNotebook={setNotebookTarget}
                  />
                ))}
              </div>
            )}
          </section>
        </>
      )}

      <NotebookSheet
        recommendation={activeNotebookRecommendation}
        open={notebookTarget !== null}
        onOpenChange={(open) => {
          if (!open) setNotebookTarget(null);
        }}
        onVideoStateChange={(status, url) => {
          if (notebookTarget) onRecommendationVideoStateChange(notebookTarget.id, status, url);
        }}
      />
    </div>
  );
}
